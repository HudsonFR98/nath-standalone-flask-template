#
# Copy to .env for local development (docker-compose dev context).
# No defaults in code: missing variables fail at startup.
#

# PostgreSQL container bootstrap DB (admin DB used by init script)
POSTGRES_DB=postgres
POSTGRES_USER=web
POSTGRES_PASSWORD=change_me_postgres

# Application database created by deploy/init-db.sh
NSFT_DB_NAME=nsft

# Flask / application secrets
SECRET_KEY=change_me_flask_secret

# Telegram (required by config; use placeholders locally if alerts are not needed)
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=change_me

# Initial admin user (bootstrapped on app start)
ADMIN_USER_USERNAME=admin
ADMIN_USER_PASSWORD=change_me_admin
ADMIN_USER_FIRST_NAME=Admin
ADMIN_USER_LAST_NAME=User
ADMIN_USER_EMAIL=admin@example.com

# Optional reviewer user (bootstrapped on app start only if USERNAME and PASSWORD are set)
REVIEWER_USER_USERNAME=reviewer
REVIEWER_USER_PASSWORD=change_me_reviewer
REVIEWER_USER_FIRST_NAME=Reviewer
REVIEWER_USER_LAST_NAME=User
REVIEWER_USER_EMAIL=reviewer@example.com
